{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FeatureSnapshot",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "snapshot_id": { "type": "string" },
    "token_mint": { "type": "string" },
    "snapshot_ts": { "type": "integer" },
    "window_name": { "type": "string" },
    "window_seconds": { "type": "integer" },
    "age_sec": { "type": ["integer", "null"] },
    "venue": { "type": ["string", "null"] },
    "event_count": { "type": "integer" },
    "possible_buy_count": { "type": "integer" },
    "possible_sell_count": { "type": "integer" },
    "token_accumulation_count": { "type": "integer" },
    "token_distribution_count": { "type": "integer" },
    "unique_actor_count": { "type": "integer" },
    "base_volume": { "type": "number" },
    "quote_volume": { "type": "number" },
    "net_base_flow": { "type": "number" },
    "net_quote_flow": { "type": "number" },
    "buy_sell_imbalance": { "type": ["number", "null"] },
    "confidence_weighted_buy_flow": { "type": "number" },
    "confidence_weighted_sell_flow": { "type": "number" },
    "confidence_weighted_net_flow": { "type": "number" },
    "avg_event_confidence": { "type": ["number", "null"] },
    "max_event_confidence": { "type": ["number", "null"] },
    "venue_counts": { "type": "object" },
    "event_type_counts": { "type": "object" },
    "metadata_json": { "type": "object" }
  },
  "required": ["snapshot_id", "token_mint", "snapshot_ts", "window_name", "window_seconds"]
}
