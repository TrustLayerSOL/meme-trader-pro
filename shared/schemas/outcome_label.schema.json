{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OutcomeLabel",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "outcome_id": { "type": "string" },
    "snapshot_id": { "type": "string" },
    "token_mint": { "type": "string" },
    "snapshot_ts": { "type": "integer" },
    "horizon_name": { "type": "string" },
    "horizon_seconds": { "type": "integer" },
    "entry_price": { "type": ["number", "null"] },
    "entry_price_ts": { "type": ["integer", "null"] },
    "entry_price_source": { "type": ["string", "null"] },
    "end_price": { "type": ["number", "null"] },
    "end_price_ts": { "type": ["integer", "null"] },
    "forward_return": { "type": ["number", "null"] },
    "max_runup": { "type": ["number", "null"] },
    "max_drawdown": { "type": ["number", "null"] },
    "price_points_count": { "type": "integer" },
    "future_event_count": { "type": "integer" },
    "future_possible_buy_count": { "type": "integer" },
    "future_possible_sell_count": { "type": "integer" },
    "future_token_accumulation_count": { "type": "integer" },
    "future_token_distribution_count": { "type": "integer" },
    "future_unique_actor_count": { "type": "integer" },
    "future_quote_volume": { "type": "number" },
    "future_base_volume": { "type": "number" },
    "survived_horizon": { "type": ["boolean", "null"] },
    "rug_like_drop": { "type": ["boolean", "null"] },
    "no_future_liquidity": { "type": "boolean" },
    "label_quality": { "type": "string" },
    "metadata_json": { "type": "object" }
  },
  "required": ["outcome_id", "snapshot_id", "token_mint", "snapshot_ts", "horizon_name", "horizon_seconds"]
}
