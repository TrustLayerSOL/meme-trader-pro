    "thesis_id": { "type": "string" },
    "created_at": { "type": "string" },
    "prior_status": { "type": "string" },
    "recommended_status": { "type": "string" },
    "confidence": { "type": "number" },
    "reason": { "type": "string" },
    "supporting_rule_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supporting_validation_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warning_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata_json": { "type": "object" }
  },
  "additionalProperties": true
}
